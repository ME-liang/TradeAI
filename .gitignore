*.log
_*
.pytest_cache/

# ===== 运行时数据缓存 =====
data/cache/

# ===== WorkBuddy 项目数据（非代码） =====
.workbuddy/

# ===== 备份/临时文件 =====
*.bak*
*.tmp

# ===== Node 依赖（前端若用到） =====
node_modules/
