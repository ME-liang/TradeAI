# ===== 密钥与环境（切勿提交） =====
.env
.env.local

# ===== Python 缓存/虚拟环境 =====
__pycache__/
*.pyc
.venv/
venv/

# ===== 生成产物 =====
output/
*.html

# ===== 编辑器/系统 =====
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.DS_Store

