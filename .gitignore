# ===== 密钥与环境（切勿提交） =====
.env
.env.local

# ===== Python 缓存/虚拟环境 =====
__pycache__/
*.pyc
.venv/
venv/

# ===== 生成产物 =====
output/
*.html

# ===== 编辑器/系统 =====
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.DS_Store

# ===== 临时调试/日志/草稿（含明文 API 日志，切勿提交） =====
*.log
_*
.pytest_cache/

# ===== 运行时数据缓存 =====
data/cache/
# SQLite WAL 模式运行期副产物（服务一跑就生成，非源码）
data/*.db-shm
data/*.db-wal

# ===== WorkBuddy 项目数据（非代码） =====
.workbuddy/

# ===== 备份/临时文件 =====
*.bak*
*.tmp

# ===== Node 依赖（前端若用到） =====
node_modules/

# ===== Step 0 基线留档（golden 基线 HTML 随仓，其余 *.html 仍忽略） =====
!tests/golden/*.html
!tests/golden/*.json

# ===== 源码白名单（修复 `_*` 与 `*.html` 两条规则误伤的源文件，均须随仓） =====
!src/**/__init__.py
!src/fundamental_agent/engine/_util.py
!src/fundamental_agent/report/*.html
!frontend/*.html
