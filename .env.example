# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，请勿提交真实密钥。

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Tushare Pro token（可选，接真实财报数据源时填）
TUSHARE_TOKEN=

# search_agent 可选 web 检索后端（WorkBuddy 复刻 Step 2；不填则仅用东财个股新闻）
# 支持 tavily 兼容形态；在 config.yaml overview_writer.search.web_provider 配置后端
SEARCH_API_KEY=

